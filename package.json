{
  "name": "nota-prototype",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "setup": "npm --prefix app ci --ignore-scripts --no-audit --no-fund",
    "dev": "npm --prefix app run dev -- --host 127.0.0.1 --port 5173",
    "build": "npm --prefix app run build",
    "preview": "npm --prefix app run preview -- --host 127.0.0.1 --port 5173",
    "deploy:mac": "node scripts/deploy-macos.mjs",
    "test": "node app/scripts/nota-check.mjs && node app/scripts/check-playback.mjs && node --test app/server/library.test.mjs app/server/score-import.test.mjs && node app/scripts/check-document-session.mjs && node app/scripts/check-input.mjs",
    "seed:library": "node scripts/seed-library.mjs",
    "score:prepare": "node scripts/prepare-score.mjs",
    "score:setup": "uv run --with music21==10.5.0 python -c \"import music21; print(music21.__version__)\"",
    "test:omr": "node app/scripts/check-omr.mjs",
    "score:search": "node scripts/search-scores.mjs",
    "test:editor": "node app/scripts/check-editor-browser.mjs",
    "test:journeys": "node app/scripts/check-app-journeys.mjs",
    "setup:omr-native": "npm --prefix app rebuild onnxruntime-node --ignore-scripts=false",
    "release:web": "node scripts/package-web.mjs"
  },
  "engines": {
    "node": ">=24 <25",
    "npm": ">=10 <11"
  },
  "packageManager": "npm@10.9.9"
}
