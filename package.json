{
  "name": "nota-prototype",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "setup": "npm --prefix app ci --no-audit --no-fund",
    "dev": "npm --prefix app run dev -- --host 127.0.0.1 --port 5173",
    "build": "npm --prefix app run build",
    "preview": "npm --prefix app run preview -- --host 127.0.0.1 --port 5173",
    "deploy:mac": "node scripts/deploy-macos.mjs",
    "test": "node app/scripts/nota-check.mjs && node app/scripts/check-playback.mjs && node --test app/server/library.test.mjs app/server/score-import.test.mjs",
    "seed:library": "node scripts/seed-library.mjs",
    "score:prepare": "node scripts/prepare-score.mjs",
    "score:setup": "uv run --with music21==10.5.0 python -c \"import music21; print(music21.__version__)\"",
    "test:omr": "node app/scripts/check-omr.mjs",
    "score:search": "node scripts/search-scores.mjs",
    "prototype:ia": "npm --prefix app run dev -- --config vite.ia-prototype.config.ts"
  }
}
